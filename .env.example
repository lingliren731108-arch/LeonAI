# Claude API Configuration
#ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: defaults to claude-3-5-sonnet-20241022 or a newer version
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI or OpenAI-Compatible API Configuration (For DALL-E 3 and alternative models like GLM, DeepSeek, etc.)
OPENAI_API_KEY=
# Optional: Set base URL for other providers (e.g. Zhipu GLM: https://open.bigmodel.cn/api/paas/v4/ )
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# Optional: Set model name (e.g. gpt-4o, glm-4-plus, deepseek-chat)
OPENAI_MODEL=GLM-5.1

# Server Configuration
SERVER_PORT=8900
SERVER_HOST=127.0.0.1

# Frontend Configuration
FRONTEND_PORT=5173

# Workspace settings (typically within the project workspace folder)
WORKSPACE_DIR=workspace/leon

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=leon_db

